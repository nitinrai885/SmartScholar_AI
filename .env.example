# Copy this file to ".env" and put your real key after the equals sign.
# Get a free key at https://console.groq.com/keys   (never commit .env to git)
GROQ_API_KEY=your_groq_api_key_here

# Optional: force one Groq model. If empty, SmartScholar AI asks Groq which models
# your key can use and picks the first available from config.GROQ_MODEL_PREFERENCE.
# See https://console.groq.com/docs/models
# GROQ_MODEL=openai/gpt-oss-20b
